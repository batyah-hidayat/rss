        {
          "id": "https://gitlab.sieuviet.services/recommendation/service-recommendation/-/commit/c12864d4e1939af271fd8e5c70151121518704c3",
          "author": null,
          "description": "- Introduced a new map to track seekers who refused consent.\n- Implemented methods to fetch and handle consent-refused seeker IDs.\n- Updated recommendation logic to exclude consent-refused seekers from notifications.\n- Enhanced logging for better tracking of consent-related operations.",
